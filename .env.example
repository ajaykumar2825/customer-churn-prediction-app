# ---------------------------------------------------------------------------
# Churn Intelligence Platform — environment template
# Copy to `.env` at the repository root and fill in secrets.
# NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# App
ENVIRONMENT=development
DEBUG=false

# Security — replace in production!
SECRET_KEY=dev-only-not-for-production
API_KEY=
# Comma-separated list of allowed CORS origins (browser host of the frontend).
ALLOWED_ORIGINS=*

# Database — blank means zero-infrastructure demo mode.
#   SQLite:   sqlite:///./churn.db
#   Postgres: postgresql+psycopg://churn:churn@localhost:5432/churn
DATABASE_URL=postgresql+psycopg://churn:churn@localhost:5432/churn

# Cache / rate limiting (blank falls back to in-process LRU).
REDIS_URL=redis://localhost:6379/0

# Model serving policy
MODEL_DIR=models
DEFAULT_THRESHOLD=0.5
HIGH_RISK_THRESHOLD=0.7
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
SEED_ON_STARTUP=true